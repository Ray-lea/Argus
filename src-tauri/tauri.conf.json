{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argus",
  "version": "0.1.0",
  "identifier": "dev.argus.taskmanager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cargo build -p argus-service --bins --release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Argus",
        "width": 1240,
        "height": 800,
        "minWidth": 860,
        "minHeight": 540,
        "center": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        },
        "visible": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://argus.localhost argus:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Argus contributors",
    "copyright": "© 2026 Argus contributors",
    "homepage": "https://github.com/Ray-lea/Argus",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "SimpChinese"
        ],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2N0Q4MkYyQjFFRDQyMEUKUldRT1F1Mng4b0o5TmdmeHV5eWRHdGV6ek1UUXVuY0xRcmlxcDhTejlaODNRWGsvQi8zK2JHWDYK",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
