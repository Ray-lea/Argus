{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["ui/**", "locales/**", "*.ts", "*.json"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": {
        // The process table is a virtualized ARIA grid:
        // focus stays on the grid body and the selected row is exposed via aria-activedescendant, so rows and cells are intentionally not focusable or semantic <tr>/<td>.
        "useFocusableInteractive": "off",
        "useSemanticElements": "off",
        "noStaticElementInteractions": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["ui/src/**/*.css"],
      "linter": {
        "rules": {
          "style": { "noDescendingSpecificity": "off" },
          "complexity": { "noImportantStyles": "off" }
        }
      }
    }
  ]
}
