{
  // rust-analyzer checks in target/rust-analyzer, the same directory `pnpm check`
  // uses for clippy: no duplicate check artifacts, and it never holds the build
  // lock while `tauri dev` rebuilds.
  "rust-analyzer.cargo.targetDir": true,
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.allTargets": true,
  "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer", "editor.formatOnSave": true },
  "[typescript][typescriptreact][css][json][jsonc]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  "css.lint.unknownAtRules": "ignore",
  "files.watcherExclude": { "**/target/**": true }
}
