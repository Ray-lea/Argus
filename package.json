{
  "name": "argus",
  "private": true,
  "version": "0.7.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "app": "node scripts/desktop.mjs dev",
    "build": "node scripts/build.mjs",
    "bundle": "node scripts/build.mjs --installer",
    "site:dev": "pnpm --dir website run dev",
    "site:build": "pnpm --filter @argus/website run build",
    "site:check": "pnpm --filter @argus/website run check",
    "check:generated": "node scripts/native-dispatch.mjs --check",
    "lint": "biome check locales resources",
    "docs:lint": "node scripts/docs-lint.mjs",
    "format": "biome format --write locales resources",
    "i18n": "node scripts/i18n.mjs",
    "test": "node --test \"scripts/tests/*.test.mjs\" \"scripts/tests/*.test.ts\"",
    "test:startup": "node scripts/test-dev-startup.mjs",
    "test:hold": "node scripts/test-dev-hold.mjs",
    "check": "pnpm lint && pnpm docs:lint && pnpm i18n && pnpm check:generated && pnpm test && cargo fmt --all --check && cargo clippy --workspace --all-targets --target-dir target/rust-analyzer -- -D warnings && cargo test --workspace --target-dir target/rust-analyzer",
    "verify": "node scripts/verify.mjs",
    "check:arm64": "cargo clippy --workspace --all-targets --target aarch64-pc-windows-msvc --target-dir target/rust-analyzer -- -D warnings",
    "check:security": "pnpm audit --audit-level low && cargo audit",
    "commitlint": "node scripts/release.mjs lint",
    "release": "node scripts/release.mjs bump"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "autocorrect-node": "^2.14.0",
    "github-slugger": "2.0.0",
    "markdownlint-cli2": "^0.24.2"
  }
}
