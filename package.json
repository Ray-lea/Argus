{
  "name": "argus",
  "private": true,
  "version": "0.3.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "app": "tauri dev --config src-tauri/tauri.dev.conf.json --additional-watch-folders crates",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ui locales",
    "format": "biome format --write ui locales",
    "i18n": "node scripts/i18n.mjs",
    "test:ui": "node --test \"ui/tests/*.test.ts\"",
    "test:signing": "node --test scripts/tests/signpath.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm i18n && pnpm test:ui && pnpm test:signing && cargo fmt --all --check && cargo clippy --workspace --all-targets --target-dir target/rust-analyzer -- -D warnings",
    "check:security": "pnpm audit --audit-level low && cargo audit",
    "commitlint": "node scripts/release.mjs lint",
    "release": "node scripts/release.mjs bump",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/solid-virtual": "^3.13.48",
    "@tauri-apps/api": "^2.12.4",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  }
}
