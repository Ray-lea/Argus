{
  "name": "argus",
  "private": true,
  "version": "0.3.4",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "app": "node scripts/desktop.mjs dev",
    "dev": "node scripts/desktop.mjs dev",
    "build": "node scripts/build.mjs",
    "bundle": "node scripts/build.mjs --installer",
    "check:generated": "node scripts/native-dispatch.mjs --check",
    "lint": "biome check locales resources",
    "format": "biome format --write locales resources",
    "i18n": "node scripts/i18n.mjs",
    "test": "node --test \"scripts/tests/*.test.mjs\" \"scripts/tests/*.test.ts\"",
    "test:signing": "node --test scripts/tests/signpath.test.mjs",
    "test:startup": "node scripts/test-dev-startup.mjs",
    "check": "pnpm lint && pnpm i18n && pnpm check:generated && pnpm test && cargo fmt --all --check && cargo clippy --workspace --all-targets --target-dir target/rust-analyzer -- -D warnings && cargo test --workspace --target-dir target/rust-analyzer",
    "check:security": "pnpm audit --audit-level low && cargo audit",
    "commitlint": "node scripts/release.mjs lint",
    "release": "node scripts/release.mjs bump"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
