/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; form-action 'self'; base-uri 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Keep the bytes of CSP-hashed HTML intact at the edge.
/
  Cache-Control: public, max-age=300, no-transform
/en/*
  Cache-Control: public, max-age=300, no-transform
/docs/*
  Cache-Control: public, max-age=300, no-transform
/download/*
  Cache-Control: public, max-age=300, no-transform
/changelog/*
  Cache-Control: public, max-age=300, no-transform
/questions/*
  Cache-Control: public, max-age=300, no-transform
/privacy/*
  Cache-Control: public, max-age=300, no-transform
/signing/*
  Cache-Control: public, max-age=300, no-transform
/security/*
  Cache-Control: public, max-age=300, no-transform
/404.html
  Cache-Control: public, max-age=300, no-transform

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=300
/docs-search.json
  Cache-Control: public, max-age=300
/llms.txt
  Cache-Control: public, max-age=300
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Cache-Control: public, max-age=300
  Content-Type: text/plain; charset=utf-8
# The Markdown copies of the documents serve tools; search results show the pages.
/llms.mdx/*
  Cache-Control: public, max-age=300
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
