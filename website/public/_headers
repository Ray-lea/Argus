/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; form-action 'self'; base-uri 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Keep the bytes of CSP-hashed HTML intact at the edge. A page's address also
# returns its Markdown copy (index.md) for Accept: text/markdown, so caches
# keep the two apart.
/
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/en/*
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/zh-TW/*
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/es/*
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/de/*
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/ja/*
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/fr/*
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/ru/*
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/docs/*
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/download/*
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/changelog/*
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/privacy/*
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/signing/*
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/security/*
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/404.html
  Cache-Control: public, max-age=300, no-transform
/index.md
  Cache-Control: public, max-age=300, no-transform
  Vary: Accept
/*index.md
  Content-Type: text/markdown; charset=utf-8

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=300
/docs-search.json
  Cache-Control: public, max-age=300
/llms.txt
  Cache-Control: public, max-age=300
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Cache-Control: public, max-age=300
  Content-Type: text/plain; charset=utf-8
# The Markdown copies of the documents serve tools; search results show the pages.
/llms.mdx/*
  Cache-Control: public, max-age=300
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
