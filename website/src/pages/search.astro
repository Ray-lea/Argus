---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../lib/site";
---

<SiteLayout
  lang="zh"
  path="/search/"
  title="文档搜索 · Argus"
  description="搜索 Argus 稳定版与开发版文档。"
  alternate={false}
  noindex
>
  <div class="wrap inner-page article-page">
    <header class="page-heading">
      <h1>搜索文档</h1>
      <p>检索稳定版与开发版的使用说明和技术文档。</p>
    </header>
    <form action="/search/" method="get" class="search-form">
      <label for="query">文档关键词</label>
      <div>
        <input id="query" type="search" name="q" maxlength="160" required />
        <button class="button">搜索</button>
      </div>
    </form>
    <p id="status" role="status" aria-live="polite"></p>
    <ol
      id="results"
      class="search-results"
      data-stable={site.editions[0].label}
    ></ol>
    <p>
      <a class="text-link" href="/docs/">
        稳定版文档 →
      </a>
      <a class="text-link" href="/docs/dev/">
        开发版文档 →
      </a>
    </p>
  </div>
  <script>
    const query = new URL(location.href).searchParams
      .get("q")
      ?.trim()
      .slice(0, 160);
    if (query) {
      document.querySelector<HTMLInputElement>("#query")!.value = query;
      const status = document.getElementById("status")!;
      status.textContent = "正在搜索…";
      try {
        const path = "/pagefind/pagefind.js";
        const engine = await import(/* @vite-ignore */ path);
        await engine.init({ language: "zh-cn" });
        const hit = await engine.search(query);
        const list = document.getElementById("results")!;
        for (const result of await Promise.all(
          hit.results.slice(0, 30).map(
            (r: {
              data: () => Promise<{
                url: string;
                meta: { title: string };
                excerpt: string;
              }>;
            }) => r.data(),
          ),
        )) {
          const li = document.createElement("li"),
            a = document.createElement("a"),
            badge = document.createElement("span"),
            p = document.createElement("p");
          a.href = result.url;
          a.textContent = result.meta.title;
          badge.className = "result-edition";
          badge.textContent = a.pathname.startsWith("/docs/dev/")
            ? "开发版"
            : (list.dataset.stable ?? "稳定版");
          p.textContent = new DOMParser().parseFromString(
            result.excerpt,
            "text/html",
          ).body.textContent;
          li.append(badge, a, p);
          list.append(li);
        }
        status.textContent = hit.results.length
          ? "找到 " + hit.results.length + " 个结果"
          : "没有匹配的文档";
      } catch {
        status.textContent = "搜索索引暂未加载，请重试或浏览文档目录。";
      }
    }
  </script>
</SiteLayout>
