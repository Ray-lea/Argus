---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  origin,
  localized,
  sourceFor,
  jsonLd,
  text,
  type Language,
} from "../lib/site";
interface Props {
  lang: Language;
  path: string;
  title: string;
  description: string;
  alternate?: boolean;
  noindex?: boolean;
  schema?: unknown;
}
const {
  lang,
  path,
  title,
  description,
  alternate = true,
  noindex = false,
  schema,
} = Astro.props;
const url = origin + localized(lang, path),
  t = text[lang];
const graph = [
  schema,
  path !== "/" &&
    !noindex && {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Argus",
          item: origin + localized(lang),
        },
        { "@type": "ListItem", position: 2, name: title, item: url },
      ],
    },
].filter(Boolean);
---

<!doctype html>
<html lang={sourceFor(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/argus.svg" type="image/svg+xml" />
    <link rel="canonical" href={url} />
    {alternate && (
      <>
        {(["zh", "en"] as const).map((l) => (
          <link
            rel="alternate"
            hreflang={sourceFor(l)}
            href={origin + localized(l, path)}
          />
        ))}
        <link rel="alternate" hreflang="x-default" href={origin + path} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Argus" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta
      property="og:image"
      content={origin + "/assets/preview-" + lang + "-dark.png"}
    />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    {graph.map((item) => (
      <script type="application/ld+json" set:html={jsonLd(item)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <Header lang={lang} path={path} alternate={alternate} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
