---
import BenchmarkResults from "./BenchmarkResults.astro";
import { groups, type Support } from "../data/tool-comparison";
import type { Language } from "../lib/site";
import "../styles/comparison.css";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const en = lang === "en",
  i = en ? 1 : 0;
const labels: Record<Support, [string, string]> = {
  builtIn: ["✓", en ? "Built in" : "内置"],
  different: ["≈", en ? "Related view" : "不同口径"],
  external: ["↗", en ? "Companion tool" : "外部工具"],
  absent: ["×", en ? "Not built in" : "未内置"],
};
---

<section class="tool-study" aria-labelledby="study-title">
  <div class="wrap">
    <h2 id="study-title">
      {en
        ? "Three tools on the same Windows PC"
        : "同一台 Windows 电脑上的三款工具"}
    </h2>
    <p class="study-intro">
      {en
        ? "Argus GPUI development build, Windows Task Manager and Process Explorer 17.2 on Windows 11."
        : "Windows 11 实测 · Argus GPUI 开发版、系统任务管理器与 Process Explorer 17.2"}
    </p>
    <BenchmarkResults lang={lang} />
    <section class="feature-matrix" aria-labelledby="compare-title">
      <div class="matrix-heading">
        <h3 id="compare-title">
          {en ? "Features and inspection depth" : "功能与信息明细"}
        </h3>
        <ul class="support-key">
          {Object.entries(labels).map(([status, [symbol, label]]) => (
            <li>
              <span class={"support " + status} aria-hidden="true">
                {symbol}
              </span>
              {label}
            </li>
          ))}
        </ul>
      </div>
      {groups.map((group) => (
        <table class="cap-table">
          <caption>{group.title[i]}</caption>
          <thead>
            <tr>
              <th scope="col">{en ? "Task" : "排查任务"}</th>
              <th scope="col">Argus</th>
              <th scope="col">{en ? "Task Manager" : "任务管理器"}</th>
              <th scope="col">Process Explorer</th>
            </tr>
          </thead>
          <tbody>
            {group.rows.map(([task, ...cells]) => (
              <tr>
                <th scope="row">{task[i]}</th>
                {cells.map(([status, zh, english]) => (
                  <td>
                    <div>
                      <span class={"support " + status} aria-hidden="true">
                        {labels[status][0]}
                      </span>
                      <span>
                        <span class="sr-only">{labels[status][1]} · </span>
                        {en ? english : zh}
                      </span>
                    </div>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      ))}
      <p class="study-sources">
        {en
          ? "The matrix combines observed screens with the product manuals. Sensor readings depend on the adapter, driver and permissions."
          : "功能明细结合实测界面和产品手册。传感器读数取决于硬件、驱动与授权。"}{" "}
        <a href="/docs/dev/guide/">Argus</a> ·{" "}
        <a href="https://support.microsoft.com/en-us/accessibility/windows/use-a-screen-reader-to-navigate-windows-support-tools">
          Windows Task Manager
        </a>{" "}
        ·{" "}
        <a href="https://learn.microsoft.com/en-us/sysinternals/downloads/process-explorer">
          Process Explorer
        </a>
      </p>
    </section>
  </div>
</section>
