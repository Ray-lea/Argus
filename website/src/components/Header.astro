---
import Icon from "./Icon.astro";
import ThemePicker from "./ThemePicker.astro";
import EditionMenu from "./EditionMenu.astro";
import { localized, repo, text, type Language } from "../lib/site";
interface Props {
  lang: Language;
  path: string;
  alternate?: boolean;
}
const { lang, path, alternate = true } = Astro.props,
  t = text[lang],
  en = lang === "en";
---

<header class="mast">
  <div class="wrap mast-row">
    <a class="brand" href={localized(lang)}>
      <img src="/assets/argus.svg" width="32" height="32" alt="" />
      Argus
    </a>
    <nav aria-label={en ? "Main navigation" : "主导航"} class="navlinks">
      <a
        class="nav-download"
        href={localized(lang, "/download/")}
        aria-current={path === "/download/" ? "page" : undefined}
      >
        {t.download}
      </a>
      <EditionMenu lang={lang} />
      <a class="nav-search" href="/search/"><Icon name="search" size={16}/>{en?"Search docs":"搜索文档"}</a>
      <a class="nav-repo" href={repo}>
        GitHub <Icon name="external" size={13} />
      </a>
      <ThemePicker lang={lang} />
      {alternate && (
        <a
          class="lang"
          href={localized(en ? "zh" : "en", path)}
          lang={en ? "zh-CN" : "en"}
          aria-label={t.language}
        >
          <Icon name="language" size={16} />
          <span class="lang-full">{t.language}</span>
          <span class="lang-short">{en ? "中文" : "EN"}</span>
        </a>
      )}
    </nav>
  </div>
</header>
