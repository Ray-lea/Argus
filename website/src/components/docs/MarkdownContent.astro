---
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import { site } from "../../lib/site";
const index = site.editions.some(
  (edition) => edition.base === Astro.url.pathname,
);
---

<div class:list={[index && "manual-directory"]}>
  <Default>
    <slot />
  </Default>
</div>
