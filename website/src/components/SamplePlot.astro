---
interface Props {
  samples: number[][];
  unit: string;
  divisor: number;
  step: number;
  label: string;
  zero?: boolean;
}
const { samples, unit, divisor, step, label, zero } = Astro.props;
const values = samples.map(([, bytes]) => bytes / divisor);
const low = zero ? 0 : Math.floor(Math.min(...values) / step) * step;
const high = Math.max(low + step, Math.ceil(Math.max(...values) / step) * step);
const start = samples[0][0],
  span = samples[samples.length - 1][0] - start;
const points = samples
  .map(([ms], i) =>
    [
      (((ms - start) / span) * 400).toFixed(2),
      (82 - ((values[i] - low) / (high - low)) * 78).toFixed(2),
    ].join(","),
  )
  .join(" ");
---

<figure class="sample-plot">
  <figcaption>
    {label} <span>{unit}</span>
  </figcaption>
  <div class="plot-inner">
    <span class="plot-scale" aria-hidden="true">
      <span>{high}</span>
      <span>{low}</span>
    </span>
    <svg
      viewBox="0 0 400 86"
      preserveAspectRatio="none"
      role="img"
      aria-label={
        label +
        ", " +
        Math.round(span / 1000) +
        " s, " +
        Math.min(...values).toFixed(1) +
        "–" +
        Math.max(...values).toFixed(1) +
        " " +
        unit
      }
    >
      <path d="M0 4H400M0 43H400M0 82H400" class="sample-guides" />
      <polygon points={"0,82 " + points + " 400,82"} class="sample-fill" />
      <polyline {points} class="sample-trace" />
    </svg>
  </div>
  <div class="sample-time" aria-hidden="true">
    <span>0 s</span>
    <span>{(span / 1000).toFixed(1)} s</span>
  </div>
</figure>
