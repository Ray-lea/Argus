---
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon.astro";
import ProductPreview from "../components/ProductPreview";
import ResourceReplay from "../components/ResourceReplay";
import FeatureGrid from "../components/FeatureGrid.astro";
import ToolComparison from "../components/ToolComparison.astro";
import trace from "../../../tools/window-probe/fixtures/readme-trace.json";
import {
  localized,
  origin,
  repo,
  site,
  text,
  editionName,
  type Language,
} from "../lib/site";
import "../styles/home.css";
import "../styles/features.css";
interface Props {
  lang: Language;
}
const { lang } = Astro.props,
  en = lang === "en",
  r = site.release;
const title = en
  ? "Argus | Open-source Windows task manager"
  : "Argus 开源 Windows 任务管理器";
const intro = en
  ? "Inspect live processes and hardware, find the app holding a file, and look back over seven days of system activity."
  : "查看实时进程与硬件读数，找出锁住文件的程序，回看最近七天的系统活动。";
---

<SiteLayout
  lang={lang}
  path="/"
  title={title}
  description={intro}
  schema={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": origin + "/#website",
    name: "Argus",
    url: origin + "/",
    inLanguage: ["zh-CN", "en"],
  }}
>
  <div class="home-page">
    <section class="workbench-hero" aria-labelledby="product-name">
      <div class="skyfield" aria-hidden="true"></div>
      <div class="hero-introduction wrap">
        <a class="release-chip" href={repo + "/releases/tag/" + r.tag}>
          <span class="release-point"></span>
          {r.tag}
          <span class="chip-rule"></span>
          {en ? "Release notes" : "发布说明"} <Icon name="arrow" size={13} />
        </a>
        <h1 id="product-name">
          {en ? (
            <>
              Argus <em>Task Manager</em>
            </>
          ) : (
            <>
              Argus <em>Windows 任务管理器</em>
            </>
          )}
        </h1>
        <p class="hero-intro">
          {en
            ? "An open-source workspace to inspect live processes and hardware, find file locks, and revisit seven days of activity."
            : "开源的进程与硬件监视工具。定位文件占用，回看最近七天的系统活动。"}
        </p>
        <div class="hero-actions">
          <a class="button primary" href={r.files.installer.url}>
            <Icon name="download" />
            {en ? "Download for Windows" : "下载 Windows 版"}
          </a>
          <a class="button secondary" href="/docs/">
            {en ? "Stable guide" : "稳定版指南"}
            <Icon name="arrow" size={16} />
          </a>
        </div>
        <p class="hero-info">
          <a href={repo + "/blob/" + r.tag + "/LICENSE"}>
            <Icon name="book" size={15} />
            {en ? "AGPL-3.0 open source" : "AGPL-3.0 开源"}
          </a>
          <a href="/docs/dev/architecture/tech-stack/">
            <Icon name="cpu" size={15} />
            {en ? "Built with Rust" : "Rust 构建"}
          </a>
          <a href={r.files.portable.url}>
            <Icon name="download" size={15} />
            {en ? "Portable edition" : "免安装版"}
          </a>
          <span>Windows x64</span>
        </p>
      </div>
      <section
        class="product-studio wrap"
        id="workspace"
        aria-label={en ? "Interactive product preview" : "交互式产品预览"}
      >
        <ProductPreview
          client:visible
          lang={lang}
          framework={site.editions[1].framework}
        />
      </section>
    </section>
    <section class="replay-section" aria-labelledby="replay-title">
      <div class="replay-grid wrap">
        <div class="replay-copy">
          <p class="section-context">
            <Icon name="activity" size={16} />{" "}
            {en ? "Resource history" : "资源历史"}
          </p>
          <h2 id="replay-title">
            {en ? "Revisit a moment in time." : "回看高占用时刻"}
          </h2>
          <p>
            {en
              ? "With history enabled, Argus keeps seven days of system readings and the busiest processes on this PC. Scrub the minute of recorded activity shown here."
              : "开启历史记录后，最近七天的整机负载和当时最忙的进程会保存在本机。拖动游标，可逐点查看这段一分钟实测记录。"}
          </p>
          <a class="text-link" href="/docs/guide/#历史">
            {en ? "Read the history guide (中文)" : "打开历史记录指南"}
            <Icon name="arrow" size={16} />
          </a>
        </div>
        <ResourceReplay
          client:visible
          lang={lang}
          samples={trace.map((p) => ({
            ms: p.ms,
            cpu: p.cpu,
            gpu: p.gpu,
            memory: p.memoryPercent,
          }))}
        />
      </div>
    </section>
    <FeatureGrid lang={lang} />
    <ToolComparison lang={lang} />
    <section
      id="handbooks"
      class="handbooks wrap"
      aria-labelledby="handbook-title"
    >
      <div class="section-head">
        <div>
          <p class="section-context">
            <Icon name="book" size={16} />
            {en ? "Documentation" : "项目文档"}
          </p>
          <h2 id="handbook-title">{en ? "Guides by version" : "版本与文档"}</h2>
        </div>
        <a class="text-link" href={localized(lang, "/questions/")}>
          {text[lang].questions}
          <Icon name="arrow" size={16} />
        </a>
      </div>
      <div class="book-shelf">
        {site.editions.map((edition, i) => (
          <a
            class:list={["book-cover", i ? "book-dev" : "book-stable"]}
            href={edition.base}
          >
            <div class="book-image">
              <img
                src={
                  "/assets/handbook-" +
                  lang +
                  "-" +
                  (i ? "dev" : "stable") +
                  ".webp"
                }
                width="820"
                height="250"
                loading="lazy"
                alt={
                  en
                    ? i
                      ? "Development build of Argus"
                      : "Stable release of Argus"
                    : i
                      ? "开发版进程页局部"
                      : "稳定版进程页局部"
                }
              />
            </div>
            <div class="book-copy">
              <div class="book-version">
                {editionName(edition, lang)}
                {edition.framework && " / " + edition.framework}
              </div>
              <h3>
                {i
                  ? en
                    ? "Development handbook"
                    : "开发版手册"
                  : en
                    ? "Stable user guide"
                    : "稳定版使用指南"}
              </h3>
              <p>
                {i
                  ? en
                    ? "Explore the current main branch, its architecture and native interface."
                    : "查阅 main 分支的原生界面、采集实现与开发说明。"
                  : en
                    ? "Instructions for the version available on the download page."
                    : "查阅官网下载版本的功能、系统要求与权限设置。"}
              </p>
            </div>

            <span class="book-arrow">
              <Icon name="arrow" size={19} />
            </span>
          </a>
        ))}
      </div>
      <nav
        class="quick-answers"
        aria-label={en ? "Common questions" : "常见问题"}
      >
        {[
          [
            "file-locks",
            en ? "Which process has a file open?" : "哪个进程占用了文件？",
          ],
          [
            "gpu-memory",
            en ? "Where can I check GPU memory?" : "在哪里查看专用显存？",
          ],
          [
            "permissions",
            en
              ? "When do I need administrator access?"
              : "哪些操作需要管理员权限？",
          ],
        ].map(([anchor, label]) => (
          <a href={localized(lang, "/questions/") + "#" + anchor}>
            {label}
            <Icon name="arrow" size={14} />
          </a>
        ))}
      </nav>
    </section>
  </div>
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries)
          if (entry.isIntersecting) {
            entry.target.classList.add("arrived");
            observer.unobserve(entry.target);
          }
      },
      { threshold: 0.16 },
    );
    document
      .querySelectorAll(
        ".section-head,.preview,.replay-copy,.replay-frame,.book-cover",
      )
      .forEach((el) => observer.observe(el));
  </script>
</SiteLayout>
