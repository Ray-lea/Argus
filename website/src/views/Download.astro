---
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon.astro";
import {
  site,
  text,
  repo,
  localized,
  softwareSchema,
  type Language,
} from "../lib/site";
interface Props {
  lang: Language;
}
const { lang } = Astro.props,
  en = lang === "en",
  t = text[lang],
  r = site.release;
const description = en
  ? "Download the Argus Windows x64 installer or portable executable, read the system requirements and verify the release checksums."
  : "下载 Argus 的 Windows x64 安装版或免安装版，查看系统要求、发布说明和 SHA-256 校验值。";
---

<SiteLayout
  lang={lang}
  path="/download/"
  title={en ? "Download Argus for Windows" : "下载 Argus Windows 版"}
  description={description}
  schema={softwareSchema(lang, description)}
>
  <div class="wrap inner-page">
    <header class="page-heading">
      <p class="release-line">
        {t.stable} · {r.tag} ·{" "}
        <time datetime={r.published}>{r.published.slice(0, 10)}</time>
      </p>
      <h1>{en ? "Download Argus" : "下载 Argus"}</h1>
      <p>
        {en
          ? "Choose the Windows x64 edition that fits how you work."
          : "为 Windows x64 选择合适的版本。"}
      </p>
    </header>
    <div class="download-list">
      {Object.entries(r.files).map(([key, file]) => {
        const setup = key === "installer";
        return (
          <article class="package-row">
            <div>
              <h2>{setup ? (en ? "Installer" : "安装版") : t.portable}</h2>
              <p>
                {setup
                  ? en
                    ? "Install with Start menu shortcuts and in-app updates."
                    : "安装到本机，创建开始菜单快捷方式，支持应用内安装更新。"
                  : en
                    ? "Run the single executable directly."
                    : "下载单个可执行文件，直接运行。"}
              </p>
              <code>{file.name}</code>{" "}
              <span class="muted">
                · {(file.size / 1048576).toFixed(2)} MiB
              </span>
            </div>
            <div class="package-actions">
              <a class:list={["button", !setup && "secondary"]} href={file.url}>
                <Icon name="download" size={16} />
                {setup
                  ? en
                    ? "Download installer"
                    : "下载安装版"
                  : en
                    ? "Download portable"
                    : "下载免安装版"}
              </a>
              <a class="text-link" href={file.upstream}>
                GitHub <Icon name="external" size={14} />
              </a>
            </div>
            <details>
              <summary>SHA-256</summary>
              <code>{file.sha256}</code>
            </details>
          </article>
        );
      })}
    </div>
    <div class="details-grid">
      <section class="prose">
        <h2>{en ? "System requirements" : "系统要求"}</h2>
        <div set:html={site.translations[lang].requirements} />
      </section>
      <section class="prose">
        <h2>{en ? "Release information" : "版本信息"}</h2>
        <ul>
          <li>
            <a href={repo + "/releases/tag/" + r.tag}>
              {en ? "Release notes" : "发布说明"} {r.tag}
            </a>
          </li>
          <li>
            <a href={"https://dl.argustask.com/" + r.tag + "/SHA256SUMS.txt"}>
              {en ? "Download checksums" : "下载完整校验值"}
            </a>
          </li>
          <li>
            <a href={localized(lang, "/signing/")}>{t.signing}</a>
          </li>
        </ul>
      </section>
    </div>
  </div>
</SiteLayout>
