{
  "about": "用隔离窗口复核触摸操作：进程树、重新排序后的长按目标、菜单、图表、150% 界面缩放下的页面滚动，以及滚动条的拖动与取消。触点识别本身由 `cargo test -p argus --test touch_input` 覆盖。",
  "window": [1240, 860],
  "steps": [
    {"control":{"page":"processes","view":"tree","details":false,"motion":"off","preference":{"processSort":{"key":"pid","desc":false}},"sample":{"set":{"/system/processCount":3,"/processes":[
      {"pid":100,"ppid":0,"createTime":1,"name":"alpha.exe","description":"Alpha","path":"C:/Examples/alpha.exe","cpu":4,"privateWs":104857600,"appWindow":true},
      {"pid":110,"ppid":100,"createTime":2,"name":"worker.exe","description":"Worker","path":"C:/Examples/worker.exe","cpu":2,"privateWs":52428800},
      {"pid":200,"ppid":0,"createTime":1,"name":"beta.exe","description":"Beta","path":"C:/Examples/beta.exe","cpu":3,"privateWs":83886080,"appWindow":true}
    ]}}},"wait":700},
    {"control":{"touch":{"at":"status-rate","event":"tap","id":1}},"wait":200,"inspect":"menu","label":"tap-opens","expect":{"state.open":true}},
    {"control":{"keys":["escape"]},"wait":100},
    {"control":{"touch":{"at":"row:0","event":"down","id":2}},"wait":650,"inspect":"menu","label":"process-long-press","expect":{"state.open":true},"capture":"process-long-press"},
    {"control":{"touch":{"event":"up","id":2}},"wait":200,"inspect":"menu","label":"release-keeps-menu","expect":{"state.open":true}},
    {"control":{"keys":["escape"]},"wait":100},
    {"control":{"touch":{"at":"row:0","event":"tap","id":3}},"wait":70},
    {"control":{"touch":{"at":"row:0","event":"tap","id":4}},"wait":200,"inspect":"layout","label":"double-tap-expands","expect":{"processTree.visibleChildren":1}},
    {"control":{"touch":{"at":"status-rate","event":"down","id":5}},"wait":80},
    {"control":{"touch":{"event":"cancel","id":5}},"wait":650,"inspect":"menu","label":"cancel-does-not-open","expect":{"state.open":false}},
    {"control":{"touch":{"at":"header:cpu","event":"down","id":11}},"wait":850,"inspect":"menu","label":"header-long-press","expect":{"state.open":true}},
    {"control":{"touch":{"event":"up","id":11}},"wait":100},
    {"control":{"keys":["escape"]},"wait":100},

    {"control":{"touch":{"at":"row:0","event":"down","id":14}},"wait":100},
    {"control":{"preference":{"processSort":{"key":"pid","desc":true}}},"wait":850,"inspect":"layout","label":"held-target-survives-sort","expect":{"selectedRow":"Alpha"}},
    {"inspect":"menu","label":"sorted-row-menu","expect":{"state.open":true}},
    {"control":{"touch":{"event":"up","id":14}},"wait":100},
    {"control":{"keys":["escape"]},"wait":100},
    {"control":{"page":"performance","device":"cpu"},"wait":600},
    {"control":{"touch":{"at":"cpu-graphs","event":"down","id":6}},"wait":650,"inspect":"menu","label":"chart-long-press","expect":{"state.open":true,"state.items":["整体视图","多核视图","","显示内核时间"]},"capture":"chart-long-press"},
    {"control":{"touch":{"event":"up","id":6}},"wait":100},
    {"control":{"keys":["escape"]},"wait":100},
    {"control":{"touch":{"at":"device-cpu","event":"down","id":12}},"wait":850,"inspect":"menu","label":"device-long-press","expect":{"state.open":true}},
    {"control":{"touch":{"event":"up","id":12}},"wait":100},
    {"control":{"keys":["escape"]},"wait":100},

    {"control":{"page":"about","preference":{"uiScale":150},"theme":"light"},"wait":600,"inspect":"layout","label":"scaled-top","expect":{"aboutScroll.canScroll":true,"aboutScroll.offset":0}},
    {"control":{"touch":{"at":"about-scroll","event":"down","id":7}},"wait":30},
    {"control":{"touch":{"event":"move","id":7,"dy":-80}},"wait":30},
    {"control":{"touch":{"event":"move","id":7,"dy":-2000}},"wait":100},
    {"control":{"touch":{"event":"up","id":7,"dy":-2000}},"wait":200,"inspect":"layout","label":"swipe-bottom","expect":{"aboutScroll.atEnd":true},"capture":"swipe-bottom"},
    {"control":{"touch":{"at":"about-scroll","event":"down","id":8}},"wait":30},
    {"control":{"touch":{"event":"move","id":8,"dy":2000}},"wait":100},
    {"control":{"touch":{"event":"up","id":8,"dy":2000}},"wait":200,"inspect":"layout","label":"swipe-top","expect":{"aboutScroll.offset":0}},
    {"note":"A fresh contact stops any remaining inertia before the direct thumb drag."},
    {"control":{"touch":{"at":"about-scroll","event":"down","id":13}},"wait":80},
    {"control":{"touch":{"event":"cancel","id":13}},"wait":100},
    {"control":{"touch":{"at":"about-scroll","fraction":[0.995,0.03],"event":"down","id":9}},"wait":50},
    {"control":{"touch":{"event":"move","id":9,"dy":1500}},"wait":100,"inspect":"layout","label":"thumb-drag","expect":{"aboutScroll.atEnd":true}},
    {"control":{"touch":{"event":"cancel","id":9}},"wait":100,"inspect":"layout","label":"thumb-cancel-restores","expect":{"aboutScroll.offset":0}},
    {"control":{"touch":{"at":"about-scroll","fraction":[0.995,0.03],"event":"down","id":10}},"wait":50},
    {"control":{"touch":{"event":"move","id":10,"dy":1500}},"wait":50},
    {"control":{"touch":{"event":"up","id":10,"dy":1500}},"wait":200,"inspect":"layout","label":"thumb-release","expect":{"aboutScroll.atEnd":true},"capture":"thumb-release"}
  ]
}
