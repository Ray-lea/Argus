{
  "about": "检查上次会话在读取磁盘详情后异常结束时的详情页：用 `data` 控制把 `diskReadsHeld` 设为真（模拟快照不读取磁盘，也不读写标记文件），核对打开详情页不发出读取、显示说明，单击“仍要读取”后才请求读取，用 `hold` 与 `resolve` 走过读取中与读取完成两种画面，其他磁盘同样等待请求，已打开的说明在恢复自动读取后保留到离开该页，重新打开后自动读取；另截取浅色主题、小窗口加大字号与宽窗口的画面。`inspectLayout.performance.diskDetails` 输出当前详情页的磁盘编号与是否等待请求，`skippedRequest` 记录被模拟快照跳过的 `disk_details` 请求。更换 `--language` 可复核各语言的换行。标记文件的写入、保留与清除由 `cargo test -p argus-app read_marker` 覆盖。",
  "window": [1000,680],
  "steps": [
    {"note":"held: the page opens without reading","control":{"data":{"diskReadsHeld":true,"skippedRequest":{"command":"none"}},"page":"performance","device":"disk:0","preference":{"diskPage":"details"},"pointerOutside":true},"wait":800,"inspect":"layout","label":"held-not-read","expect":{"page":"performance","device":"disk:0","performance.diskDetails.disk":0,"performance.diskDetails.held":true,"skippedRequest.command":"none"},"capture":"held"},
    {"control":{"hoverAnchor":"disk-details-read"},"wait":300,"capture":"held-hover"},
    {"note":"the button asks for the read","control":{"clickAnchor":"disk-details-read"},"wait":300,"inspect":"layout","label":"held-read-asked","expect":{"skippedRequest.command":"disk_details","skippedRequest.args.index":0,"performance.diskDetails.held":true}},
    {"note":"a read that takes long","control":{"hold":{"command":"disk_details","cache":"diskDetails.0","args":{"index":0}},"pointerOutside":true},"wait":600,"capture":"held-reading"},
    {"control":{"resolve":{"command":"disk_details","ok":true,"value":{"index":0,"queriedAt":1794211200000,"volumes":["C:"],"identity":{"model":"Nimbus P700 2TB","serialNumber":"NP700A1B2C3D4E5","firmwareRevision":"N240620a","bus":"nvme","busCode":17,"removable":false},"capacityBytes":2000398934016,"solidState":true,"logicalSectorBytes":512,"physicalSectorBytes":4096,"trimEnabled":true,"queries":[{"query":"open","state":"ready"},{"query":"identity","state":"ready"}]}}},"wait":500,"capture":"held-answered"},
    {"note":"another disk waits to be asked as well","control":{"device":"disk:1","pointerOutside":true},"wait":700,"inspect":"layout","label":"held-other-disk","expect":{"device":"disk:1","performance.diskDetails.disk":1,"performance.diskDetails.held":true,"skippedRequest.args.index":0},"capture":"held-other-disk"},
    {"note":"what was read stays; opening it again does not read","control":{"device":"disk:0"},"wait":700,"inspect":"layout","label":"held-kept","expect":{"performance.diskDetails.disk":0,"performance.diskDetails.held":true},"capture":"held-kept"},
    {"note":"a page that said why keeps saying so once reads run again","control":{"device":"disk:1","data":{"skippedRequest":{"command":"none"}}},"wait":600},
    {"control":{"data":{"diskReadsHeld":false}},"wait":500,"inspect":"layout","label":"held-until-left","expect":{"performance.diskDetails.disk":1,"performance.diskDetails.held":true,"skippedRequest.command":"none"}},
    {"note":"opened again, it reads by itself","control":{"preference":{"diskPage":"overview"}},"wait":400},
    {"control":{"preference":{"diskPage":"details"}},"wait":600,"inspect":"layout","label":"reads-again","expect":{"performance.diskDetails.disk":1,"performance.diskDetails.held":false,"skippedRequest.command":"disk_details","skippedRequest.args.index":1},"capture":"reads-again"},
    {"note":"a disk that was read shows its details","control":{"device":"disk:0"},"wait":700,"inspect":"layout","label":"normal","expect":{"performance.diskDetails.disk":0,"performance.diskDetails.held":false},"capture":"normal"},
    {"note":"light theme, small window, large text","control":{"data":{"diskReadsHeld":true},"device":"disk:1","theme":"light","pointerOutside":true},"wait":800,"inspect":"layout","label":"held-light","expect":{"performance.diskDetails.disk":1,"performance.diskDetails.held":true},"capture":"held-light"},
    {"probe":"size 640 480","wait":700,"capture":"held-small"},
    {"control":{"preference":{"uiScale":150,"fontSize":16}},"wait":900,"capture":"held-small-large-text"},
    {"control":{"preference":{"uiScale":100,"fontSize":13},"theme":"dark"},"probe":"size 1800 900","wait":900,"capture":"held-wide"}
  ]
}
