    {"control":{"wheel":{"x":400,"y":500,"lines":-9}},"capture":"scrolled"},
    {"control":{"wheel":{"x":400,"y":500,"lines":-600}},"capture":"bottom"},
    {"control":{"wheel":{"x":400,"y":500,"lines":600}}},
    {"control":{"pointerOutside":true}},
    {"control":{"sort":"name","pointerOutside":true},"capture":"sorted-name"},
    {"control":{"wheel":{"x":400,"y":500,"lines":-9}},"wait":2400,"capture":"groups-scrolled"},
    {"control":{"wheel":{"x":400,"y":500,"lines":600}},"wait":1500},
    {"control":{"pointerOutside":true}},
    {"control":{"sort":"cpu","pointerOutside":true},"capture":"sorted-cpu"},
