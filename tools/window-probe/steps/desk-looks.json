{
  "about": "以全部读数逐一捕获桌面监控的列表（卡片、色条、分隔线）、曲线、仪表与横条，经右键菜单的测试控制切换样式，单击组件页的样式卡片（锚点 `desktopStyle-<样式>`）并核对保存的样式，捕获深浅主题下的组件页与各样式，最后把保存的位置设在屏幕右下角之外，核对窗口仍在工作区内；`inspectLayout.monitors.desktop` 另输出显示方式、样式、分组、组数、各读数的曲线条数、窗口尺寸与 `onScreen`。模拟快照没有历史采样，曲线用 `desk-live.json` 查看。",
  "window": [1100, 900],
  "steps": [
    {"control":{"page":"components"},"wait":700},
    {"control":{"desktopMonitor":{"enabled":true,"metrics":["cpu","cpuTemperature","cpuClock","cpuPower","memory","memoryUsed","gpu","gpuTemperature","gpuMemory","gpuClock","gpuPower","gpuFan","disk","diskActive","diskTemperature","network","battery","uptime"]}},"wait":1800},
    {"inspect":"layout","label":"list","expect":{"monitors.desktop.visible":true,"monitors.desktop.layout":"panel","monitors.desktop.style":"list","monitors.desktop.grouping":"cards","monitors.desktop.groups":7,"monitors.desktop.onScreen":true}},
    {"captureWindow":{"name":"list-cards-dark","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"desktopMonitor":{"grouping":"stripes"}},"wait":1000,"captureWindow":{"name":"list-stripes-dark","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"desktopMonitor":{"grouping":"rules"}},"wait":1000,"captureWindow":{"name":"list-rules-dark","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"desktopMonitorMenu":"look:curves"},"wait":2500},
    {"inspect":"layout","label":"curves","expect":{"monitors.desktop.style":"curves","monitors.desktop.grouping":"rules","monitors.desktop.onScreen":true}},
    {"captureWindow":{"name":"curves-rules-dark","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"desktopMonitor":{"grouping":"cards"}},"wait":1000,"captureWindow":{"name":"curves-cards-dark","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"desktopMonitorMenu":"look:gauges"},"wait":1200,"captureWindow":{"name":"gauges-dark","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"desktopMonitorMenu":"look:strip"},"wait":1500},
    {"inspect":"layout","label":"strip","expect":{"monitors.desktop.layout":"strip","monitors.desktop.onScreen":true}},
    {"captureWindow":{"name":"strip-all-dark","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"desktopMonitor":{"metrics":["cpu","memory","gpu","disk","network"]}},"wait":1500,"captureWindow":{"name":"strip-dark","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"desktopMonitor":{"layout":"panel"}},"wait":1200,"captureWindow":{"name":"gauges-basic-dark","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"clickAnchor":"components-nav-desktop","pointerOutside":true},"wait":900,"capture":"components-desktop-dark"},
    {"control":{"wheel":{"x":650,"y":500,"lines":-10}},"wait":900,"capture":"components-desktop-look-dark"},
    {"control":{"clickAnchor":"desktopStyle-list","pointerOutside":true},"wait":1200},
    {"inspect":"layout","label":"page-click","expect":{"monitors.desktop.style":"list"}},
    {"captureWindow":{"name":"list-basic-dark","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"theme":"light"},"wait":1200,"capture":"components-desktop-look-light"},
    {"captureWindow":{"name":"list-basic-light","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"desktopMonitor":{"metrics":["cpu","cpuTemperature","memory","memoryUsed","gpu","gpuTemperature","gpuMemory","disk","diskActive","network"],"style":"curves"}},"wait":2500,"captureWindow":{"name":"curves-light","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"desktopMonitor":{"style":"gauges"}},"wait":1200,"captureWindow":{"name":"gauges-light","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"desktopMonitor":{"layout":"strip"}},"wait":1500,"captureWindow":{"name":"strip-light","class":"Zed::Window","title":"桌面监控"}},
    {"control":{"desktopMonitor":{"enabled":false}},"wait":900},
    {"control":{"desktopMonitor":{"enabled":true,"layout":"panel","style":"list","position":[2500,1400]}},"wait":1800},
    {"inspect":"layout","label":"kept-inside","expect":{"monitors.desktop.visible":true,"monitors.desktop.onScreen":true}},
    {"control":{"desktopMonitor":{"enabled":false}},"wait":900},
    {"inspect":"layout","label":"off","expect":{"monitors.desktop":null}}
  ]
}
