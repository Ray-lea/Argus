{
  "window": [1240, 900],
  "steps": [
    { "note": "Run on a machine with a graphics card: without one the first device is already the software one." },
    { "control": { "page": "performance", "motion": "fluid", "pointerOutside": true }, "wait": 1200, "capture": "hardware-performance" },
    { "control": { "page": "settings", "settingsSection": "motion", "pointerOutside": true }, "wait": 700, "inspect": "layout", "label": "hardware",
      "expect": { "graphics.softwareRequested": false, "graphics.software": false }, "capture": "hardware-settings" },
    { "note": "Off: the open window moves to the software rasterizer in place." },
    { "record": { "name": "to-software", "ms": 2400 }, "wait": 800 },
    { "control": { "clickAnchor": "hardwareAcceleration" }, "wait": 1800, "inspect": "layout", "label": "software",
      "expect": { "graphics.softwareRequested": true, "graphics.software": true }, "capture": "software-settings" },
    { "control": { "page": "performance", "pointerOutside": true }, "wait": 1200, "capture": "software-performance" },
    { "control": { "page": "processes", "pointerOutside": true }, "wait": 900, "capture": "software-processes" },
    { "control": { "theme": "light", "page": "performance", "pointerOutside": true }, "wait": 1200, "capture": "software-performance-light" },
    { "note": "The tray's flyouts are windows of the same device." },
    { "control": { "trayFlyout": "panel" }, "wait": 1200, "captureFlyout": "software-panel" },
    { "control": { "trayFlyout": "close", "theme": "dark" }, "wait": 500 },
    { "note": "Hidden while the renderer changes back, then shown." },
    { "probe": "hide", "wait": 500 },
    { "control": { "page": "settings", "settingsSection": "motion" }, "wait": 300 },
    { "probe": "show", "wait": 1200 },
    { "record": { "name": "to-hardware", "ms": 2400 }, "wait": 800 },
    { "control": { "clickAnchor": "hardwareAcceleration" }, "wait": 1800, "inspect": "layout", "label": "hardware-again",
      "expect": { "graphics.softwareRequested": false, "graphics.software": false }, "capture": "hardware-again" },
    { "control": { "page": "performance", "pointerOutside": true }, "wait": 1200, "capture": "hardware-performance-again" }
  ]
}
