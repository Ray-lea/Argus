{
  "window": [1000, 680],
  "steps": [
    {"control":{"page":"network","preference":{"startPage":"processes"}},"wait":400},
    {"probe":"hide","wait":250},
    {"probe":"show","wait":500,"inspect":"layout","label":"keep-by-default","expect":{"page":"network"}},
    {"control":{"page":"components"},"wait":500,"capture":"tray-settings"},
    {"control":{"clickAnchor":"settings-tray-page"},"wait":250,"capture":"tray-page-options"},
    {"control":{"keys":["down","enter"]},"wait":250},
    {"control":{"page":"network","preference":{"notice.trayRate":true}},"wait":300},
    {"probe":"hide","wait":250},
    {"probe":"show","wait":500,"inspect":"layout","label":"opt-in-through-selector","expect":{"page":"processes"}},
    {"control":{"page":"history"},"wait":300},
    {"probe":"show","wait":400,"inspect":"layout","label":"visible-window-keeps-page","expect":{"page":"history"}},
    {"control":{"restored":{"from":"minimized","firstShow":false,"awayMs":1000}},"wait":400,"inspect":"layout","label":"minimized-keeps-page","expect":{"page":"history"}},
    {"control":{"restored":{"from":"tray","firstShow":true,"awayMs":1000}},"wait":400,"inspect":"layout","label":"first-show-keeps-page","expect":{"page":"history"}},
    {"control":{"page":"network","dialog":"filelock"},"wait":400},
    {"probe":"hide","wait":250},
    {"probe":"show","wait":500,"inspect":"layout","label":"dialog-keeps-context","expect":{"page":"network","dialog.kind":"filelock"}},
    {"control":{"dismiss":true},"wait":300},
    {"probe":"hide","wait":250},
    {"probe":"show","wait":500,"inspect":"layout","label":"next-reopen-uses-default","expect":{"page":"processes","dialog":null}},
    {"control":{"query":"Argus","sort":"name"},"wait":300},
    {"probe":"hide","wait":250},
    {"probe":"show","wait":500,"inspect":"layout","label":"current-default-keeps-filter","expect":{"page":"processes","processTree.searching":true}},
    {"control":{"page":"network"},"wait":300},
    {"probe":"hide","wait":250},
    {"probe":"show","wait":500,"inspect":"layout","label":"return-keeps-default-filter","expect":{"page":"processes","processTree.searching":true}},
    {"control":{"page":"network","preference":{"startPage":"services"}},"wait":300},
    {"probe":"hide","wait":250},
    {"probe":"show","wait":500,"inspect":"layout","label":"changed-default-applies","expect":{"page":"services"}},
    {"control":{"page":"history","preference":{"trayPage":"current"}},"wait":300},
    {"probe":"hide","wait":250},
    {"probe":"show","wait":500,"inspect":"layout","label":"disabled-immediately","expect":{"page":"history"}},
    {"control":{"page":"components"},"probe":"size 640 480","wait":500,"capture":"tray-settings-small"}
  ]
}
