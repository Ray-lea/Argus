{
  "about": "检查组件页与设置页左侧的分组列表：单击分组跳转、滚轮滚动后标记跟随、从托盘设置入口打开时回到托盘分组，核对宽窗口下卡片列不超过 960 px，并捕获深浅主题与窄窗口（不显示列表）的画面。`inspectLayout.sections` 记录两页列表当前标出的分组，`sections.cards` 为两页卡片列最近一次绘制的左边与宽度；分组的测试锚点为 `<页面>-nav-<分组>`，如 `components-nav-taskbar`。",
  "window": [1200, 760],
  "steps": [
    {"control":{"page":"components","pointerOutside":true},"inspect":"layout","label":"components-top","expect":{"sections.components":"tray"},"capture":"components-top-dark"},
    {"control":{"clickAnchor":"components-nav-taskbar"},"inspect":"layout","label":"picked","expect":{"sections.components":"taskbar"}},
    {"control":{"pointerOutside":true},"capture":"components-taskbar-dark"},
    {"control":{"clickAnchor":"components-nav-planned"},"inspect":"layout","label":"picked-last","expect":{"sections.components":"planned"},"capture":"components-planned-dark"},
    {"control":{"wheel":{"x":800,"y":400,"lines":150}},"inspect":"layout","label":"wheel-up","expect":{"sections.components":"tray"}},
    {"control":{"wheel":{"x":800,"y":400,"lines":-10}},"inspect":"layout","label":"wheel-down","expect":{"sections.components":"desktop"},"capture":"components-scrolled-dark"},
    {"control":{"locate":{"section":"components","item":"trayInterval"}},"inspect":"layout","label":"located","expect":{"sections.components":"tray"},"capture":"components-located-dark"},
    {"control":{"theme":"light","pointerOutside":true},"wait":900,"capture":"components-light"},
    {"control":{"page":"settings","settingsSection":"rules"},"inspect":"layout","label":"settings","expect":{"sections.settings":"rules"},"capture":"settings-rules-light"},
    {"control":{"clickAnchor":"settings-nav-language"},"inspect":"layout","label":"settings-picked","expect":{"sections.settings":"language"}},
    {"probe":"size 1700 900","wait":900,"inspect":"layout","label":"settings-wide","expect":{"sections.cards.settings.1":960},"capture":"settings-wide-light"},
    {"control":{"page":"components"},"inspect":"layout","label":"components-wide","expect":{"sections.cards.components.1":960}},
    {"control":{"theme":"dark"},"probe":"size 820 600","wait":900,"capture":"components-narrow-dark"}
  ]
}
