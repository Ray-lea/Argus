{
  "about": "逐页截取进程、性能、服务、启动、连接、历史、设置、关于各页与引导对话框，另含最小窗口加大字号与分数缩放；用 `--language` 换语言复核各语言的排版。",
  "window": [1240, 860],
  "steps": [
    {"control":{"page":"processes","fontSize":13,"theme":"dark"},"wait":700,"capture":"processes"},
    {"control":{"page":"performance"},"capture":"performance"},
    {"control":{"page":"services"},"capture":"services"},
    {"control":{"page":"startup"},"capture":"startup"},
    {"control":{"page":"network"},"capture":"connections"},
    {"control":{"page":"history"},"capture":"history"},
    {"control":{"page":"settings","settingsSection":"language"},"capture":"settings"},
    {"control":{"page":"about"},"capture":"about"},
    {"control":{"dialog":"onboarding","args":{"step":0}},"inspect":"layout","label":"welcome","expect":{"dialog.kind":"onboarding","dialog.ready":true},"capture":"welcome"},
    {"control":{"dismiss":true,"page":"settings","settingsSection":"language","fontSize":20,"theme":"light"},"probe":"size 640 480","wait":700,"capture":"minimum-large-text"},
    {"control":{"dialog":"onboarding","args":{"step":0}},"inspect":"layout","label":"minimum-welcome","expect":{"dialog.ready":true,"dialog.settled":true},"capture":"minimum-welcome"},
    {"control":{"dismiss":true,"fontSize":13,"contentZoom":1.5},"probe":"size 1240 860","wait":700,"capture":"fractional-scale"}
  ]
}
