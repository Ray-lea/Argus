    {"control":{"preference":{"processSort":{"key":"powerTrend","desc":false}},"view":"list","theme":"light","pointerOutside":true},"wait":600,"capture":"power-trend-light"},
    {"control":{"dialog":"columns"},"wait":1000,"capture":"power-dialog-light"}
  ]
