{
  "window": [1000, 680],
  "steps": [
    {"control": {"page": "processes", "theme": "dark"}, "wait": 1200, "inspect": "layout", "label": "initial", "expect": {"caption.keepOnTop": false, "caption.keepOnTopIsClient": true, "caption.underCaptionsDrags": true, "nativeWindow.topmost": false}, "capture": "dark"},
    {"crop": {"from": "dark", "name": "dark-captions", "region": [700, 0, 300, 60], "scale": 3}},
    {"control": {"pointer": {"at": [977, 16], "event": "hover"}}, "wait": 300, "capture": "dark-hover-close"},
    {"crop": {"from": "dark-hover-close", "name": "dark-hover-close-captions", "region": [700, 0, 300, 60], "scale": 3}},
    {"control": {"pointer": {"at": [931, 16], "event": "hover"}}, "wait": 300, "capture": "dark-hover-maximize"},
    {"crop": {"from": "dark-hover-maximize", "name": "dark-hover-maximize-captions", "region": [700, 0, 300, 60], "scale": 3}},
    {"control": {"hoverAnchor": "caption-on-top"}, "wait": 1000, "capture": "dark-hover-on-top"},
    {"crop": {"from": "dark-hover-on-top", "name": "dark-hover-on-top-captions", "region": [640, 0, 360, 110], "scale": 3}},
    {"control": {"clickAnchor": "caption-on-top"}, "wait": 600, "inspect": "layout", "label": "kept-on-top", "expect": {"caption.keepOnTop": true, "caption.keepOnTopIsClient": true, "nativeWindow.topmost": false}},
    {"control": {"pointerOutside": true}, "wait": 600, "capture": "dark-on-top"},
    {"crop": {"from": "dark-on-top", "name": "dark-on-top-captions", "region": [700, 0, 300, 60], "scale": 3}},
    {"control": {"theme": "light"}, "wait": 900, "capture": "light-on-top"},
    {"crop": {"from": "light-on-top", "name": "light-on-top-captions", "region": [700, 0, 300, 60], "scale": 3}},
    {"control": {"clickAnchor": "caption-on-top"}, "wait": 600, "inspect": "layout", "label": "not-on-top", "expect": {"caption.keepOnTop": false}},
    {"control": {"pointerOutside": true}, "wait": 600, "capture": "light"},
    {"crop": {"from": "light", "name": "light-captions", "region": [700, 0, 300, 60], "scale": 3}},
    {"control": {"dialog": "shortcuts"}, "wait": 900, "capture": "light-dialog"},
    {"crop": {"from": "light-dialog", "name": "light-dialog-captions", "region": [700, 0, 300, 60], "scale": 3}},
    {"control": {"dismiss": true, "theme": "dark"}, "wait": 900},
    {"control": {"dialog": "shortcuts"}, "wait": 900, "capture": "dark-dialog"},
    {"crop": {"from": "dark-dialog", "name": "dark-dialog-captions", "region": [700, 0, 300, 60], "scale": 3}},
    {"control": {"dismiss": true}, "wait": 600},
    {"control": {"preference": {"uiScale": 150}}, "wait": 900, "inspect": "layout", "label": "scaled", "expect": {"caption.keepOnTopIsClient": true, "caption.underCaptionsDrags": true}, "capture": "dark-scaled"},
    {"crop": {"from": "dark-scaled", "name": "dark-scaled-captions", "region": [620, 0, 380, 90], "scale": 2}},
    {"control": {"preference": {"uiScale": 100, "navPosition": "side"}}, "probe": "size 640 520", "wait": 900, "inspect": "layout", "label": "narrow-side", "expect": {"caption.keepOnTopIsClient": true}, "capture": "dark-narrow-side"},
    {"control": {"preference": {"navPosition": "top"}}, "wait": 900, "capture": "dark-narrow"}
  ]
}
