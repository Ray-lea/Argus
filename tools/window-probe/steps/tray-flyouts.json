{
  "about": "捕获组件页、悬停卡片与快捷面板（含新版本入口）的深浅主题画面，以及设置页指向组件页的卡片。改用 `--live` 可核对面板中的实时曲线。真实托盘的悬停与右键单击由 Shell 发起，测试实例不创建托盘图标。",
  "window": [1100, 760],
  "steps": [
    {"control":{"page":"components"},"capture":"components-dark"},
    {"control":{"trayFlyout":"card"},"wait":900,"captureFlyout":"card-dark"},
    {"control":{"trayFlyout":"close"},"wait":500},
    {"control":{"trayFlyout":"panel"},"wait":900,"captureFlyout":"panel-dark"},
    {"control":{"trayFlyout":"close"},"wait":500},
    {"control":{"data":{"updates":{"state":"ready","version":"0.5.1"}}}},
    {"control":{"trayFlyout":"panel"},"wait":900,"captureFlyout":"panel-update-dark"},
    {"control":{"trayFlyout":"close"},"wait":500},
    {"control":{"theme":"light"},"wait":700,"capture":"components-light"},
    {"control":{"trayFlyout":"card"},"wait":900,"captureFlyout":"card-light"},
    {"control":{"trayFlyout":"close"},"wait":500},
    {"control":{"trayFlyout":"panel"},"wait":900,"captureFlyout":"panel-light"},
    {"control":{"trayFlyout":"close"},"wait":500},
    {"control":{"page":"settings","settingsSection":"startup"},"capture":"settings-startup-light"}
  ]
}
