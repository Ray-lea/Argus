{
  "window": [1240, 860],
  "steps": [
    { "note": "Performance page: three samples give the CPU graphs a curve and its kernel time." },
    { "control": { "page": "performance", "device": "cpu", "cpuMode": "overall", "pointerOutside": true,
        "sample": { "at": -2000, "set": { "/system/cpu": 38, "/system/cpuKernel": 9,
          "/system/cores": [52, 20, 61, 44, 30, 18, 70, 35, 48, 26, 57, 41, 33, 22, 46, 29, 38, 24, 51, 36],
          "/system/coreKernel": [14, 4, 22, 9, 6, 3, 31, 8, 12, 5, 20, 10, 7, 4, 15, 6, 9, 5, 17, 8] } } }, "wait": 400 },
    { "control": { "sample": { "at": -1000, "set": { "/system/cpu": 64, "/system/cpuKernel": 21,
          "/system/cores": [80, 46, 72, 66, 58, 37, 91, 60, 69, 49, 77, 62, 55, 43, 68, 51, 61, 47, 74, 59],
          "/system/coreKernel": [30, 11, 26, 21, 15, 9, 44, 18, 24, 12, 33, 19, 14, 10, 25, 13, 20, 11, 29, 17] } } }, "wait": 400 },
    { "control": { "sample": { "at": 0, "set": { "/system/cpu": 47, "/system/cpuKernel": 13,
          "/system/cores": [63, 31, 55, 49, 41, 25, 78, 44, 52, 34, 60, 46, 39, 28, 50, 36, 45, 32, 57, 42],
          "/system/coreKernel": [19, 7, 17, 13, 10, 5, 36, 11, 16, 8, 23, 12, 9, 6, 14, 9, 12, 7, 20, 11] } } }, "wait": 1200,
      "inspect": "layout", "label": "kernel-shown",
      "expect": { "performance.kernelTime": true, "performance.overallSeries": 2 }, "capture": "overall-kernel" },

    { "note": "A right press on the graph opens its menu, the keyboard on the checked entry; Enter hides the layer." },
    { "control": { "pointer": { "at": "cpu-graphs", "event": "context" } }, "wait": 500, "inspect": "menu", "label": "cpu-menu",
      "expect": { "state.open": true, "state.keyboard": true, "state.items": ["显示内核时间"],
        "state.focus.item.label": "显示内核时间", "state.focus.item.checked": true }, "capture": "cpu-menu" },
    { "control": { "keys": ["enter"] }, "wait": 800, "inspect": "layout", "label": "kernel-hidden",
      "expect": { "performance.kernelTime": false, "performance.overallSeries": 1 }, "capture": "overall-plain" },

    { "note": "The processors' graphs share the choice; their menu brings the layer back." },
    { "control": { "cpuMode": "logical", "pointerOutside": true }, "wait": 1000, "inspect": "layout", "label": "cores-plain",
      "expect": { "performance.coreSeries": 1 }, "capture": "cores-plain" },
    { "control": { "pointer": { "at": "cpu-graphs", "event": "context" } }, "wait": 500, "inspect": "menu", "label": "cores-menu",
      "expect": { "state.open": true, "state.focus.item.checked": false } },
    { "control": { "keys": ["enter"] }, "wait": 800, "inspect": "layout", "label": "cores-kernel",
      "expect": { "performance.kernelTime": true, "performance.coreSeries": 2 }, "capture": "cores-kernel" },

    { "note": "Device list: a row's menu hides it, and the rows below close up." },
    { "control": { "pointer": { "at": "device-nic:2", "event": "context" } }, "wait": 500, "inspect": "menu", "label": "device-menu",
      "expect": { "state.open": true, "state.keyboard": true,
        "state.items": ["隐藏“vEthernet (WSL)”", "", "显示的设备", "磁盘排序", "", "恢复默认显示", "恢复默认顺序"],
        "state.disabled": [false, false, false, false, false, true, true] }, "capture": "device-menu" },
    { "control": { "keys": ["enter"] }, "wait": 800, "inspect": "layout", "label": "hidden",
      "expect": { "performance.devices": ["cpu", "memory", "disk:0", "disk:1", "nic:1", "gpu:7001", "bat:0"],
        "performance.hidden": ["nic:Hyper-V Virtual Ethernet Adapter|vEthernet (WSL)"], "performance.selected": "cpu" },
      "capture": "device-hidden" },

    { "note": "A hidden row that was selected hands the selection to the row after it." },
    { "control": { "device": "disk:1" }, "wait": 700 },
    { "control": { "pointer": { "at": "device-disk:1", "event": "context" } }, "wait": 500 },
    { "control": { "keys": ["enter"] }, "wait": 800, "inspect": "layout", "label": "selected-hidden",
      "expect": { "performance.devices": ["cpu", "memory", "disk:0", "nic:1", "gpu:7001", "bat:0"], "performance.selected": "nic:1" },
      "capture": "selected-hidden" },

    { "note": "The submenu checks devices back in and out without closing." },
    { "control": { "pointer": { "at": "device-cpu", "event": "context" } }, "wait": 500 },
    { "control": { "keys": ["down", "right"] }, "wait": 600, "inspect": "menu", "label": "submenu",
      "expect": { "state.focus.in": "submenu", "state.focus.item.label": "CPU", "state.focus.item.checked": true },
      "capture": "device-submenu" },
    { "control": { "keys": ["down", "down", "down", "enter"] }, "wait": 800, "inspect": "menu", "label": "checked",
      "expect": { "state.open": true, "state.focus.item.label": "磁盘 1 (D: E:)", "state.focus.item.checked": true } },
    { "control": { "keys": ["escape", "escape"] }, "wait": 400, "inspect": "layout", "label": "returned",
      "expect": { "performance.devices": ["cpu", "memory", "disk:0", "disk:1", "nic:1", "gpu:7001", "bat:0"] } },

    { "note": "A hidden device opened from elsewhere returns to the list." },
    { "control": { "device": "nic:2" }, "wait": 800, "inspect": "layout", "label": "revealed",
      "expect": { "performance.hidden": [], "performance.selected": "nic:2" } },

    { "note": "The list keeps its last row: with one left, hiding is unavailable." },
    { "control": { "preference": { "perfHiddenDevices": ["memory", "disk:nvme|Samsung SSD 990 PRO 2TB|2000000000000",
        "disk:sata|WDC WD40EZAZ-00SF3B0|4000000000000", "nic:Intel(R) Wi-Fi 6E AX211 160MHz|WLAN",
        "nic:Hyper-V Virtual Ethernet Adapter|vEthernet (WSL)", "gpu:NVIDIA GeForce RTX 4060 Laptop GPU", "bat:CT-4410|0001"] } }, "wait": 800,
      "inspect": "layout", "label": "one-left", "expect": { "performance.devices": ["cpu"], "performance.selected": "cpu" }, "capture": "one-left" },
    { "control": { "pointer": { "at": "device-cpu", "event": "context" } }, "wait": 500, "inspect": "menu", "label": "last-row",
      "expect": { "state.disabled": [true, false, false, false, false, false, true] } },

    { "note": "Restore default view brings every device back; the same in the light theme." },
    { "control": { "keys": ["up", "enter"] }, "wait": 900, "inspect": "layout", "label": "restored",
      "expect": { "performance.devices": ["cpu", "memory", "disk:0", "disk:1", "nic:1", "nic:2", "gpu:7001", "bat:0"], "performance.hidden": [] },
      "capture": "restored" },
    { "control": { "theme": "light", "device": "cpu", "pointerOutside": true }, "wait": 1500, "capture": "light-cores" },
    { "control": { "cpuMode": "overall" }, "wait": 1000 },
    { "control": { "pointer": { "at": "cpu-graphs", "event": "context" } }, "wait": 500, "capture": "light-cpu-menu" },
    { "control": { "keys": ["escape"] }, "wait": 300 },
    { "control": { "pointer": { "at": "device-disk:1", "event": "context" } }, "wait": 500, "capture": "light-device-menu" },
    { "control": { "keys": ["escape"] }, "wait": 300 },
    { "control": { "theme": "dark" }, "wait": 600 }
  ]
}
