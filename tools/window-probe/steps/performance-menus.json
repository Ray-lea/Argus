{
  "about": "检查性能页的两个右键菜单：CPU 图表的菜单切换整体与多核视图，多核视图下筛选核心类型（整体视图不列出核心类型），“显示内核时间”在两种视图间共用；设备列表可隐藏某一项、在“显示的设备”子菜单中逐项勾选并恢复默认显示；另核对隐藏选中项后的选中项、仅剩一项时不可隐藏、从别处打开已隐藏设备时该项回到列表，以及浅色主题。`pointer` 的 `context` 事件在已记录元素上按下并松开右键，CPU 图表区记录为 `cpu-graphs`，设备项记录为 `device-<设备标识>`；`inspectLayout.performance` 输出列表显示的设备、已隐藏设备的标识、选中项、CPU 视图（`cpuMode`）、生效的核心类型（`coreFilter`）、内核时间开关，以及 CPU 总图与第一张逻辑处理器图的序列数。录制过渡时让 `record` 先于触发它的控制一步开始（间隔约 700 ms）：捕获会话建立需要数百毫秒，同一步内发出的控制会在第一帧到达前完成过渡。",
  "window": [1240, 860],
  "steps": [
    { "note": "Performance page: three samples give the CPU graphs a curve and its kernel time." },
    { "control": { "page": "performance", "device": "cpu", "cpuMode": "overall", "pointerOutside": true,
        "sample": { "at": -2000, "set": { "/system/cpu": 38, "/system/cpuKernel": 9,
          "/system/cores": [52, 20, 61, 44, 30, 18, 70, 35, 48, 26, 57, 41, 33, 22, 46, 29, 38, 24, 51, 36],
          "/system/coreKernel": [14, 4, 22, 9, 6, 3, 31, 8, 12, 5, 20, 10, 7, 4, 15, 6, 9, 5, 17, 8] } } }, "wait": 400 },
    { "control": { "sample": { "at": -1000, "set": { "/system/cpu": 64, "/system/cpuKernel": 21,
          "/system/cores": [80, 46, 72, 66, 58, 37, 91, 60, 69, 49, 77, 62, 55, 43, 68, 51, 61, 47, 74, 59],
          "/system/coreKernel": [30, 11, 26, 21, 15, 9, 44, 18, 24, 12, 33, 19, 14, 10, 25, 13, 20, 11, 29, 17] } } }, "wait": 400 },
    { "control": { "sample": { "at": 0, "set": { "/system/cpu": 47, "/system/cpuKernel": 13,
          "/system/cores": [63, 31, 55, 49, 41, 25, 78, 44, 52, 34, 60, 46, 39, 28, 50, 36, 45, 32, 57, 42],
          "/system/coreKernel": [19, 7, 17, 13, 10, 5, 36, 11, 16, 8, 23, 12, 9, 6, 14, 9, 12, 7, 20, 11] } } }, "wait": 1200,
      "inspect": "layout", "label": "kernel-shown",
      "expect": { "performance.kernelTime": true, "performance.overallSeries": 2 }, "capture": "overall-kernel" },

    { "note": "A right press on the graph opens its menu with the keyboard on the first entry: the overall view has no core types; Enter on the last entry hides the layer." },
    { "control": { "pointer": { "at": "cpu-graphs", "event": "context" } }, "inspect": "menu", "label": "cpu-menu",
      "expect": { "state.open": true, "state.keyboard": true, "state.items": ["整体视图", "多核视图", "", "显示内核时间"],
        "state.checked": [true, false, false, true], "state.focus.item.label": "整体视图" }, "capture": "cpu-menu" },
    { "control": { "keys": ["down", "down"] }, "inspect": "menu", "label": "cpu-menu-kernel",
      "expect": { "state.focus.item.label": "显示内核时间", "state.focus.item.checked": true } },
    { "control": { "keys": ["enter"] }, "inspect": "layout", "label": "kernel-hidden",
      "expect": { "performance.kernelTime": false, "performance.overallSeries": 1 }, "capture": "overall-plain" },

    { "note": "The menu switches to the processors' graphs, which share the layer's choice." },
    { "control": { "pointer": { "at": "cpu-graphs", "event": "context" } } },
    { "control": { "keys": ["down", "enter"] }, "inspect": "layout", "label": "cores-plain",
      "expect": { "performance.cpuMode": "logical", "performance.coreSeries": 1 } },
    { "control": { "pointerOutside": true }, "capture": "cores-plain" },

    { "note": "On a hybrid CPU the processors' menu adds the core types; picking one keeps the view." },
    { "control": { "pointer": { "at": "cpu-graphs", "event": "context" } }, "inspect": "menu", "label": "cores-menu",
      "expect": { "state.open": true,
        "state.items": ["整体视图", "多核视图", "", "全部核心", "仅性能核", "仅能效核", "", "显示内核时间"],
        "state.checked": [false, true, false, true, false, false, false, false] }, "capture": "cores-menu" },
    { "control": { "keys": ["down", "down", "down", "down", "enter"] }, "inspect": "layout", "label": "cores-e",
      "expect": { "performance.cpuMode": "logical", "performance.coreFilter": "e" } },
    { "control": { "pointerOutside": true }, "capture": "cores-e" },
    { "control": { "pointer": { "at": "cpu-graphs", "event": "context" } }, "inspect": "menu", "label": "cores-e-menu",
      "expect": { "state.checked": [false, true, false, false, false, true, false, false] } },
    { "control": { "keys": ["down", "down", "enter"] }, "inspect": "layout", "label": "cores-all",
      "expect": { "performance.cpuMode": "logical", "performance.coreFilter": "all" } },
    { "control": { "pointer": { "at": "cpu-graphs", "event": "context" } } },
    { "control": { "keys": ["up", "enter"] }, "inspect": "layout", "label": "cores-kernel",
      "expect": { "performance.kernelTime": true, "performance.coreSeries": 2 } },
    { "control": { "pointerOutside": true }, "capture": "cores-kernel" },

    { "note": "Device list: a row's menu hides it, and the rows below close up." },
    { "control": { "pointer": { "at": "device-nic:2", "event": "context" } }, "inspect": "menu", "label": "device-menu",
      "expect": { "state.open": true, "state.keyboard": true,
        "state.items": ["隐藏“vEthernet (WSL)”", "", "显示的设备", "磁盘排序", "", "恢复默认显示", "恢复默认顺序"],
        "state.disabled": [false, false, false, false, false, true, true] }, "capture": "device-menu" },
    { "control": { "keys": ["enter"] }, "inspect": "layout", "label": "hidden",
      "expect": { "performance.devices": ["cpu", "memory", "disk:0", "disk:1", "nic:1", "gpu:7001", "bat:0"],
        "performance.hidden": ["nic:Hyper-V Virtual Ethernet Adapter|vEthernet (WSL)"], "performance.selected": "cpu" },
      "capture": "device-hidden" },

    { "note": "A hidden row that was selected hands the selection to the row after it." },
    { "control": { "device": "disk:1" } },
    { "control": { "pointer": { "at": "device-disk:1", "event": "context" } } },
    { "control": { "keys": ["enter"] }, "inspect": "layout", "label": "selected-hidden",
      "expect": { "performance.devices": ["cpu", "memory", "disk:0", "nic:1", "gpu:7001", "bat:0"], "performance.selected": "nic:1" },
      "capture": "selected-hidden" },

    { "note": "The submenu checks devices back in and out without closing." },
    { "control": { "pointer": { "at": "device-cpu", "event": "context" } } },
    { "control": { "keys": ["down", "right"] }, "inspect": "menu", "label": "submenu",
      "expect": { "state.focus.in": "submenu", "state.focus.item.label": "CPU", "state.focus.item.checked": true },
      "capture": "device-submenu" },
    { "control": { "keys": ["down", "down", "down", "enter"] }, "inspect": "menu", "label": "checked",
      "expect": { "state.open": true, "state.focus.item.label": "磁盘 1 (D: E:)", "state.focus.item.checked": true } },
    { "control": { "keys": ["escape", "escape"] }, "inspect": "layout", "label": "returned",
      "expect": { "performance.devices": ["cpu", "memory", "disk:0", "disk:1", "nic:1", "gpu:7001", "bat:0"] } },

    { "note": "A hidden device opened from elsewhere returns to the list." },
    { "control": { "device": "nic:2" }, "inspect": "layout", "label": "revealed",
      "expect": { "performance.hidden": [], "performance.selected": "nic:2" } },

    { "note": "The list keeps its last row: with one left, hiding is unavailable." },
    { "control": { "preference": { "perfHiddenDevices": ["memory", "disk:nvme|Samsung SSD 990 PRO 2TB|2000000000000",
        "disk:sata|WDC WD40EZAZ-00SF3B0|4000000000000", "nic:Intel(R) Wi-Fi 6E AX211 160MHz|WLAN",
        "nic:Hyper-V Virtual Ethernet Adapter|vEthernet (WSL)", "gpu:NVIDIA GeForce RTX 4060 Laptop GPU", "bat:CT-4410|0001"] } }, "inspect": "layout", "label": "one-left", "expect": { "performance.devices": ["cpu"], "performance.selected": "cpu" }, "capture": "one-left" },
    { "control": { "pointer": { "at": "device-cpu", "event": "context" } }, "inspect": "menu", "label": "last-row",
      "expect": { "state.disabled": [true, false, false, false, false, false, true] } },

    { "note": "Restore default view brings every device back; the same in the light theme." },
    { "control": { "keys": ["up", "enter"] }, "inspect": "layout", "label": "restored",
      "expect": { "performance.devices": ["cpu", "memory", "disk:0", "disk:1", "nic:1", "nic:2", "gpu:7001", "bat:0"], "performance.hidden": [] },
      "capture": "restored" },
    { "control": { "theme": "light", "device": "cpu", "pointerOutside": true }, "wait": 1500, "capture": "light-cores" },
    { "control": { "cpuMode": "overall" } },
    { "control": { "pointer": { "at": "cpu-graphs", "event": "context" } }, "capture": "light-cpu-menu" },
    { "control": { "keys": ["escape"] } },
    { "control": { "pointer": { "at": "device-disk:1", "event": "context" } }, "capture": "light-device-menu" },
    { "control": { "keys": ["escape"] } },
    { "control": { "theme": "dark" }, "wait": 600 }
  ]
}
