cesses/78/sessionId":2,"/processes/94/sessionId":2,"/processes/95/sessionId":2,"/processes/96/sessionId":2,"/processes/97/sessionId":2,"/processes/98/sessionId":2,"/processes/99/sessionId":2,"/processes/100/sessionId":2,"/processes/101/sessionId":2,"/processes/102/sessionId":2,"/processes/116/sessionId":2,"/processes/118/sessionId":2}},"pointerOutside":true},"wait":500,"inspect":"layout","label":"two-users-auto","expect":{"userGroups.mode":"auto","userGroups.users":2,"userGroups.grouped":true,"userGroups.headings.length":3,"userGroups.headings.0.title":"Alex","userGroups.headings.0.count":46,"userGroups.headings.1.title":"Morgan","userGroups.headings.1.count":20,"userGroups.headings.2.key":"u:system","userGroups.headings.2.count":54},"capture":"apps-cpu"},
    {"control":{"preference":{"processSort":{"key":"name","desc":false}},"pointerOutside":true},"wait":400,"capture":"apps-name"},
    {"note":"a category folds for every user; a user folds alone","control":{"foldRow":1,"pointerOutside":true},"wait":300,"capture":"apps-name-category-folded"},
    {"control":{"foldRow":1,"pointerOutside":true},"wait":300},
    {"control":{"foldRow":0,"pointerOutside":true},"wait":300,"inspect":"layout","label":"own-user-folded","expect":{"userGroups.headings.0.expanded":false,"userGroups.headings.1.expanded":true},"capture":"apps-name-user-folded"},
    {"note":"a search shows every match, folded groups included","control":{"query":"chrome","pointerOutside":true},"wait":400,"inspect":"layout","label":"search","expect":{"userGroups.grouped":true,"userGroups.headings.length":2,"userGroups.headings.0.expanded":true},"capture":"apps-search"},
    {"control":{"query":"","pointerOutside":true},"wait":300},
    {"control":{"foldRow":0,"pointerOutside":true},"wait":300},
    {"control":{"view":"tree","preference":{"processSort":{"key":"mem","desc":true}},"pointerOutside":true},"wait":400,"inspect":"layout","label":"tree","expect":{"userGroups.grouped":true,"userGroups.headings.length":3},"capture":"tree-memory"},
    {"control":{"view":"list","preference":{"processSort":{"key":"cpu","desc":true}},"pointerOutside":true},"wait":400,"inspect":"layout","label":"list","expect":{"userGroups.grouped":true,"userGroups.headings.length":3},"capture":"list-cpu"},
    {"note":"the visibility rules apply inside the groups","control":{"preference":{"hideSystem.processes":true},"pointerOutside":true},"wait":400,"inspect":"layout","label":"hidden-system","expect":{"visibility.enabled":true},"capture":"list-hidden-system"},
    {"control":{"preference":{"hideSystem.processes":false},"view":"apps","pointerOutside":true},"wait":300},
    {"note":"the same app of the other user: its own row, members and history","control":{"query":"chrome","pointerOutside":true},"wait":300},
    {"control":{"selectRow":3,"details":"open","pointerOutside":true},"wait":500,"capture":"details-other-user-app"},
    {"control":{"query":"","details":"closed","preference":{"openDetails":null},"pointerOutside":true},"wait":300},
    {"note":"a saved choice wins over the signed-in users","control":{"preference":{"groupByUser":"off"},"pointerOutside":true},"wait":400,"inspect":"layout","label":"two-users-off","expect":{"userGroups.mode":"off","userGroups.users":2,"userGroups.grouped":false,"userGroups.headings.length":0}},
    {"control":{"sample":{"set":{"/sessions":[{"id":1,"user":"Alex","domain":"MOCK-PC","current":true,"disconnected":false}]}},"preference":{"groupByUser":"on"},"pointerOutside":true},"wait":400,"inspect":"layout","label":"one-user-on","expect":{"userGroups.mode":"on","userGroups.users":1,"userGroups.grouped":true,"userGroups.headings.length":2,"userGroups.headings.1.key":"u:system","userGroups.headings.1.count":74},"capture":"one-user-always"},
    {"control":{"preference":{"groupByUser":"auto"},"pointerOutside":true},"wait":400,"inspect":"layout","label":"one-user-auto","expect":{"userGroups.mode":"auto","userGroups.grouped":false,"userGroups.headings.length":0}},
    {"note":"the second user signs in again: followed without a restart","control":{"sample":{"set":{"/sessions":[{"id":1,"user":"Alex","domain":"MOCK-PC","current":true,"disconnected":false},{"id":2,"user":"Morgan","domain":"MOCK-PC","current":false,"disconnected":true}]}},"theme":"light","pointerOutside":true},"wait":600,"inspect":"layout","label":"two-users-again","expect":{"userGroups.grouped":true,"userGroups.headings.length":3},"capture":"apps-light"},
    {"control":{"theme":"dark","page":"settings","locate":{"section":"language","item":"groupByUser"}},"wait":700},
    {"control":{"wheel":{"x":600,"y":400,"lines":-6},"pointerOutside":true},"wait":400,"capture":"setting"},
    {"note":"the smallest window","control":{"page":"processes","pointerOutside":true},"probe":"size 640 480","wait":500,"capture":"small-window"}
