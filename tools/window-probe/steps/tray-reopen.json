{
  "window": [1100, 760],
  "steps": [
    {"control":{"page":"components","windowMotion":"off","pointerOutside":true},"wait":700,"inspect":"layout","label":"motion-off","expect":{"animations.window":false}},
    {"probe":"hide","wait":300},
    {"control":{"trayFlyout":"card"},"wait":900,"inspect":"layout","label":"card","expect":{"tray.card":true,"tray.visible":true,"tray.animated":false,"tray.samplingShown":true},"captureFlyout":"card"},
    {"control":{"trayFlyout":"panel"},"wait":900,"inspect":"layout","label":"card-to-panel","expect":{"tray.panel":true,"tray.visible":true,"tray.samplingShown":true},"captureFlyout":"panel"},
    {"control":{"trayFlyout":"panel"},"wait":700,"inspect":"layout","label":"panel-closed","expect":{"tray.panel":false,"tray.visible":false,"tray.samplingShown":false}},
    {"control":{"trayFlyout":"panel"},"wait":900,"inspect":"layout","label":"panel-reopened","expect":{"tray.panel":true,"tray.visible":true,"tray.samplingShown":true}},
    {"control":{"trayFlyout":"close"},"wait":700,"inspect":"layout","label":"closed","expect":{"tray.visible":false,"tray.samplingShown":false}},
    {"control":{"theme":"light","windowMotion":"on"},"wait":300},
    {"control":{"trayFlyout":"card"},"wait":900},
    {"control":{"trayFlyout":"panel"},"wait":900,"inspect":"layout","label":"motion-on-panel","expect":{"tray.panel":true,"tray.visible":true,"tray.samplingShown":true},"captureFlyout":"panel-light"},
    {"control":{"trayFlyout":"close"},"wait":700,"inspect":"layout","label":"motion-on-closed","expect":{"tray.visible":false,"tray.samplingShown":false}}
  ]
}
