{
  "about": "检查状态栏的刷新控件：单击刷新状态打开频率菜单，再次单击收起，1 秒后再单击重新打开；单击右端按钮暂停、继续刷新。暂停按钮以窗口内坐标单击（1400×900 窗口、100% 缩放），用截图核对按钮位置在两种状态下相同。",
  "window": [1400, 900],
  "steps": [
    {"control":{"page":"processes","details":false,"motion":"off"},"wait":500,"capture":"running"},
    {"control":{"clickAnchor":"status-rate"},"wait":300,"inspect":"menu","label":"opened","expect":{"state.open":true},"capture":"opened"},
    {"control":{"clickAnchor":"status-rate"},"wait":400,"inspect":"menu","label":"closed-again","expect":{"state.open":false}},
    {"wait":1100},
    {"control":{"clickAnchor":"status-rate"},"wait":300,"inspect":"menu","label":"reopened","expect":{"state.open":true}},
    {"control":{"keys":["escape"]},"wait":400,"inspect":"menu","label":"escaped","expect":{"state.open":false}},
    {"control":{"mouse":{"type":"move","x":1268,"y":882}},"wait":50},
    {"control":{"mouse":{"type":"down","x":1268,"y":882}},"wait":50},
    {"control":{"mouse":{"type":"up","x":1268,"y":882}},"wait":400,"inspect":"layout","label":"paused","capture":"paused"},
    {"control":{"mouse":{"type":"move","x":1268,"y":882}},"wait":50},
    {"control":{"mouse":{"type":"down","x":1268,"y":882}},"wait":50},
    {"control":{"mouse":{"type":"up","x":1268,"y":882}},"wait":400,"inspect":"layout","label":"resumed","capture":"resumed"}
  ]
}
